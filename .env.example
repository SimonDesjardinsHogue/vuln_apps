# Copiez ce fichier vers .env :   cp .env.example .env
# lab.sh et Docker Compose lisent automatiquement .env.

# --- Ports publies (sur 127.0.0.1 uniquement) -------------------------------
JUICE_SHOP_PORT=3000
DVWA_PORT=4280
WEBGOAT_PORT=8080
WEBWOLF_PORT=9090

# --- Identifiants de la base DVWA (locaux, jetables par nature) -------------
DVWA_DB_ROOT_PASSWORD=dvwa
DVWA_DB_PASSWORD=p@ssw0rd

# --- Fuseau horaire (WebGoat) -----------------------------------------------
TZ=Europe/Paris

# --- Versions des images (epingler pour un laboratoire reproductible) -------
# Remplacer "latest" par un tag precis, ex. JUICE_SHOP_TAG=v19.1.1
JUICE_SHOP_TAG=latest
DVWA_TAG=latest
DVWA_DB_TAG=10
WEBGOAT_TAG=latest
